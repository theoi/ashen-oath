[sub_resource type="Resource" id="Resource_ybfhr"]
script = ExtResource("2_ugsee")
speaker = &"morrigan"
text = "Enough. You will last. For a while."
shot = 1

[sub_resource type="Resource" id="Resource_smmbx"]
script = ExtResource("2_ugsee")
speaker = &"morrigan"
text = "The road to the throne runs under the city, through the Drowned Crypt."

[sub_resource type="Resource" id="Resource_78tdr"]
script = ExtResource("2_ugsee")
speaker = &"aldric"
text = "Then I go down."
shot = 2

[sub_resource type="Resource" id="Resource_exvgr"]
script = ExtResource("2_ugsee")
speaker = &"morrigan"
text = "Gorrath holds the crypt. The Reckoning's champion. He has never lost a night."
shot = 1

[sub_resource type="Resource" id="Resource_c7kyr"]
script = ExtResource("2_ugsee")
speaker = &"morrigan"
text = "Men walk down to him, and the water carries what is left of them back up."

[sub_resource type="Resource" id="Resource_mn0ku"]
script = ExtResource("2_ugsee")
speaker = &"aldric"
text = "Then he has never fought a man who cannot afford to lose."
shot = 2

[sub_resource type="Resource" id="Resource_fw2rj"]
script = ExtResource("2_ugsee")
speaker = &"morrigan"
text = "Go. I will keep a candle lit for you. Do not make me tend your body."
shot = 0

