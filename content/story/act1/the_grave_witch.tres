[sub_resource type="Resource" id="Resource_hm46y"]
script = ExtResource("2_h48n3")
text = "The candles gutter. Someone has been tending them."
shot = 0

[sub_resource type="Resource" id="Resource_6eo41"]
script = ExtResource("2_h48n3")
speaker = &"morrigan"
text = "You broke my dead, knight. I had only just laid them out."
shot = 1

[sub_resource type="Resource" id="Resource_heok1"]
script = ExtResource("2_h48n3")
speaker = &"aldric"
text = "They came for me. I sent them back."
shot = 2

[sub_resource type="Resource" id="Resource_846e7"]
script = ExtResource("2_h48n3")
speaker = &"morrigan"
text = "Back where? There is nowhere left to send them."
shot = 1

[sub_resource type="Resource" id="Resource_88p88"]
script = ExtResource("2_h48n3")
speaker = &"morrigan"
text = "I see it in you. The fire under the skin. The Oath is eating you from the inside."

[sub_resource type="Resource" id="Resource_qg6sr"]
script = ExtResource("2_h48n3")
speaker = &"aldric"
text = "Then I will reach the throne before it finishes. Show me the way."
shot = 2

[sub_resource type="Resource" id="Resource_pfugr"]
script = ExtResource("2_h48n3")
speaker = &"morrigan"
text = "I do not guide men who hollow halfway down the road. Show me you will last the night."
shot = 1

