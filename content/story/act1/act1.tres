[sub_resource type="Resource" id="Resource_wn64k"]
script = ExtResource("4_2pj7u")
speaker = &"oath_shade"
speaker_name = "The Oath-Shade"
text = "You cannot put me out. I am the fire. I am what you are becoming."
shot = 0

[sub_resource type="Resource" id="Resource_eh37x"]
script = ExtResource("4_2pj7u")
speaker = &"aldric"
text = "Then burn for me, not against me. We have a king to reach."

[sub_resource type="Resource" id="Resource_vgbdc"]
script = ExtResource("4_2pj7u")
text = "The shadow folds back into him. The fire settles. For now."
shot = 1

[sub_resource type="Resource" id="Resource_qjvcc"]
script = ExtResource("4_2pj7u")
text = "Far above, the bell tolls. In its tower, something vast and made of bone turns from the window."
cue = &"bell_toll"

[sub_resource type="Resource" id="Resource_u2wsw"]
script = ExtResource("4_2pj7u")
text = "And in the dark of the crypt, a porcelain mask shaped like a bird watches him go."
shot = 2

