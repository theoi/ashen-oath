text = "I can't. The king's word holds these chains, and the chains hold me in this hole."
shot = 1

[sub_resource type="Resource" id="Resource_vipjk"]
script = ExtResource("4_2pj7u")
speaker = &"gorrath"
text = "Forty nights I have won. Forty nights I have stayed exactly where I am."

[sub_resource type="Resource" id="Resource_o825n"]
script = ExtResource("4_2pj7u")
speaker = &"gorrath"
text = "So give me one of two things, knight. A death worth having, or chains worth breaking."

[sub_resource type="Resource" id="Resource_svffx"]
