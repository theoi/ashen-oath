enter_line = 5

[sub_resource type="Resource" id="Resource_4wuat"]
script = ExtResource("4_2pj7u")
speaker = &"gorrath"
text = "Hold. I have had my answer."
shot = 0

[sub_resource type="Resource" id="Resource_fpma6"]
script = ExtResource("4_2pj7u")
speaker = &"gorrath"
text = "Kill the king, and the chains fall. Mine too."

[sub_resource type="Resource" id="Resource_35tyy"]
script = ExtResource("4_2pj7u")
speaker = &"aldric"
text = "Then wait for me."

[sub_resource type="Resource" id="Resource_emnxu"]
script = ExtResource("4_2pj7u")
text = "Aldric goes deeper. The fire in his chest flares, and keeps flaring."
shot = 1

[sub_resource type="Resource" id="Resource_pvnrt"]
script = ExtResource("4_2pj7u")
speaker = &"aldric"
text = "No. Not here. Not yet."
shot = 3

[sub_resource type="Resource" id="Resource_met17"]
script = ExtResource("4_2pj7u")
text = "The Oathfire tears loose from him. It rises out of the black water wearing his face."
shot = 1

[sub_resource type="Resource" id="Resource_q21k8"]
script = ExtResource("4_2pj7u")
speaker = &"oath_shade"
speaker_name = "The Oath-Shade"
text = "You refused the Oath, Aldric. I am what it left in you instead."
shot = 2

[sub_resource type="Resource" id="Resource_f7ss1"]
script = ExtResource("4_2pj7u")
speaker = &"oath_shade"
speaker_name = "The Oath-Shade"
text = "Kneel. It is easier than what comes next."

