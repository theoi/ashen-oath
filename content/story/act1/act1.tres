[sub_resource type="Resource" id="Resource_8tt5c"]
script = ExtResource("4_2pj7u")
text = "Black water to the ankle. Somewhere in the dark, chains drag across stone."
shot = 0

[sub_resource type="Resource" id="Resource_stcif"]
script = ExtResource("4_2pj7u")
speaker = &"gorrath"
text = "Another knight. They always send knights."
shot = 1

[sub_resource type="Resource" id="Resource_tcy56"]
