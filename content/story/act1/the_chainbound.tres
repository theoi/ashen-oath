[sub_resource type="Resource" id="Resource_8tt5c"]
script = ExtResource("2_nainb")
text = "Black water to the ankle. Somewhere in the dark, chains drag across stone."
shot = 0

[sub_resource type="Resource" id="Resource_stcif"]
script = ExtResource("2_nainb")
speaker = &"gorrath"
text = "Another knight. They always send knights."
shot = 1

[sub_resource type="Resource" id="Resource_tcy56"]
script = ExtResource("2_nainb")
speaker = &"aldric"
text = "No one sent me. Stand aside, champion."
shot = 2

[sub_resource type="Resource" id="Resource_crp1t"]
script = ExtResource("2_nainb")
speaker = &"gorrath"
text = "I can't. The king's word holds these chains, and the chains hold me in this hole."
shot = 1

[sub_resource type="Resource" id="Resource_vipjk"]
script = ExtResource("2_nainb")
speaker = &"gorrath"
text = "Forty nights I have won. Forty nights I have stayed exactly where I am."

[sub_resource type="Resource" id="Resource_o825n"]
script = ExtResource("2_nainb")
speaker = &"gorrath"
text = "So give me one of two things, knight. A death worth having, or chains worth breaking."

[sub_resource type="Resource" id="Resource_svffx"]
script = ExtResource("2_nainb")
speaker = &"aldric"
text = "I can promise you one of them."
shot = 2

