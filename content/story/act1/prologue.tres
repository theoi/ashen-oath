[sub_resource type="Resource" id="Resource_84u20"]
script = ExtResource("2_8juuh")
kind = 1
title = "Vael"
text = "Vael was a kingdom once. Its king feared death more than he loved his people, and he swore an oath to a nameless dark to escape it. Every soul sworn to him was bound with him. It is called the Ashen Oath."

[sub_resource type="Resource" id="Resource_kucjl"]
script = ExtResource("2_8juuh")
kind = 1
title = "The Reckoning"
text = "Now he is the Hollow King. Each night his great bell tolls, and the cursed must fight in the old proving grounds. Winners keep their minds for one more night. Losers hollow into the mindless dead."

[sub_resource type="Resource" id="Resource_cfo53"]
script = ExtResource("2_8juuh")
kind = 1
title = "The Oathbreaker"
text = "One knight refused the Oath. It took him anyway."

[sub_resource type="Resource" id="Resource_i0p6m"]
script = ExtResource("2_8juuh")
text = "The Ashen Chapel. Ash falls through the broken roof. Somewhere above the city, a bell begins to toll."
shot = 1
cue = &"bell_toll"

[sub_resource type="Resource" id="Resource_6fjjv"]
script = ExtResource("2_8juuh")
speaker = &"aldric"
text = "Ash in my mouth. Ash in my lungs."

[sub_resource type="Resource" id="Resource_d05am"]
script = ExtResource("2_8juuh")
speaker = &"aldric"
text = "I knelt to no dark power. And still it burns in me."
shot = 2

[sub_resource type="Resource" id="Resource_slu3l"]
script = ExtResource("2_8juuh")
speaker = &"aldric"
text = "That bell. I stood guard beneath it for twenty years."

[sub_resource type="Resource" id="Resource_skjsg"]
script = ExtResource("2_8juuh")
speaker = &"aldric"
text = "Then the throne is where it has always been. And so is he."
shot = 0

